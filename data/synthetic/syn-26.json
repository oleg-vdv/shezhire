{
 "id": "syn-26",
 "narrator": "Мария",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Мария, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.0,
   "text": "Моего прадеда звали Мұрат, он родился в 1897 году под Семей."
  },
  {
   "id": 2,
   "start": 15.4,
   "end": 20.6,
   "text": "Его жену, мою прабабушку, звали Айгүл."
  },
  {
   "id": 3,
   "start": 21.0,
   "end": 26.8,
   "text": "У них было двое детей: Құдайберген и Бауыржан."
  },
  {
   "id": 4,
   "start": 27.2,
   "end": 33.8,
   "text": "Құдайберген – это мой дед, атам, он работал трактористом."
  },
  {
   "id": 5,
   "start": 34.2,
   "end": 42.1,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 42.5,
   "end": 46.6,
   "text": "В 1944 году он женился."
  },
  {
   "id": 7,
   "start": 47.0,
   "end": 52.1,
   "text": "Жену деда звали Ұлжан, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.5,
   "end": 61.4,
   "text": "Дед всю жизнь дружил с соседом, его звали Тимур, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.8,
   "end": 67.4,
   "text": "У деда и Ұлжан родился сын Сәкен, мой отец."
  },
  {
   "id": 10,
   "start": 67.8,
   "end": 72.1,
   "text": "Отец родился в 1954 году."
  },
  {
   "id": 11,
   "start": 72.5,
   "end": 79.5,
   "text": "Мою маму зовут Зәуре, она вышла замуж за Сәкен после института."
  },
  {
   "id": 12,
   "start": 79.9,
   "end": 86.6,
   "text": "А у Бауыржан своих детей было много, но я их почти не знаю."
  }
 ],
