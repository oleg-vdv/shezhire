{
 "id": "syn-02",
 "narrator": "Нұржан",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Нұржан, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.3,
   "text": "Моего прадеда звали Ғалым, он родился в 1904 году под Кокпекты."
  },
  {
   "id": 2,
   "start": 15.7,
   "end": 21.1,
   "text": "Его жену, мою прабабушку, звали Қарлыға."
  },
  {
   "id": 3,
   "start": 21.5,
   "end": 26.7,
   "text": "У них было двое детей: Төлеген и Әсел."
  },
  {
   "id": 4,
   "start": 27.1,
   "end": 33.2,
   "text": "Төлеген – это мой дед, атам, он работал агрономом."
  },
  {
   "id": 5,
   "start": 33.6,
   "end": 41.5,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.9,
   "end": 46.0,
   "text": "В 1951 году он женился."
  },
  {
   "id": 7,
   "start": 46.4,
   "end": 51.6,
   "text": "Жену деда звали Ақмарал, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.0,
   "end": 60.9,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.3,
   "end": 67.1,
   "text": "У деда и Ақмарал родился сын Жандос, мой отец."
  },
  {
   "id": 10,
   "start": 67.5,
   "end": 71.8,
   "text": "Отец родился в 1955 году."
  },
  {
   "id": 11,
   "start": 72.2,
   "end": 79.3,
   "text": "Мою маму зовут Динара, она вышла замуж за Жандос после института."
  },
  {
   "id": 12,
   "start": 79.7,
   "end": 85.4,
   "text": "У меня есть сестра Шолпан, мы росли в Зайсан."
  },
  {
   "id": 13,
   "start": 85.8,
   "end": 92.2,
   "text": "А у Әсел своих детей было много, но я их почти не знаю."
  }
 ],
