{
 "id": "syn-17",
 "narrator": "Серік",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Серік, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.3,
   "text": "Моего прадеда звали Нұрлан, он родился в 1890 году под Түркістан."
  },
  {
   "id": 2,
   "start": 15.7,
   "end": 20.9,
   "text": "Его жену, мою прабабушку, звали Зәуре."
  },
  {
   "id": 3,
   "start": 21.3,
   "end": 26.4,
   "text": "У них было двое детей: Ғалым и Ахмет."
  },
  {
   "id": 4,
   "start": 26.8,
   "end": 32.9,
   "text": "Ғалым – это мой дед, атам, он работал трактористом."
  },
  {
   "id": 5,
   "start": 33.3,
   "end": 41.2,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.6,
   "end": 45.7,
   "text": "В 1936 году он женился."
  },
  {
   "id": 7,
   "start": 46.1,
   "end": 51.3,
   "text": "Жену деда звали Бибігүл, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.7,
   "end": 60.6,
   "text": "Дед всю жизнь дружил с соседом, его звали Олжас, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.0,
   "end": 67.0,
   "text": "У деда и Бибігүл родились сын Берік и дочь Жанар."
  },
  {
   "id": 10,
   "start": 67.4,
   "end": 73.0,
   "text": "Берік – мой отец, әкем, родился в 1948 году."
  },
  {
   "id": 11,
   "start": 73.4,
   "end": 80.4,
   "text": "Мою маму зовут Сәуле, она вышла замуж за Берік после института."
  },
  {
   "id": 12,
   "start": 80.8,
   "end": 86.9,
   "text": "У меня есть брат Әбдірахман, мы росли в Қарқаралы."
  },
  {
   "id": 13,
   "start": 87.3,
   "end": 93.8,
   "text": "А у Ахмет своих детей было много, но я их почти не знаю."
  }
 ],
