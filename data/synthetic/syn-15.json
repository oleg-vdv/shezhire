{
 "id": "syn-15",
 "narrator": "Шолпан",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Шолпан, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.3,
   "text": "Моего прадеда звали Қайрат, он родился в 1892 году под Шымкент."
  },
  {
   "id": 2,
   "start": 15.7,
   "end": 20.9,
   "text": "Его жену, мою прабабушку, звали Сәуле."
  },
  {
   "id": 3,
   "start": 21.3,
   "end": 26.5,
   "text": "У них было двое детей: Данияр и Күләш."
  },
  {
   "id": 4,
   "start": 26.9,
   "end": 32.8,
   "text": "Данияр – это мой дед, атам, он работал шофёром."
  },
  {
   "id": 5,
   "start": 33.2,
   "end": 41.1,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.5,
   "end": 45.6,
   "text": "В 1944 году он женился."
  },
  {
   "id": 7,
   "start": 46.0,
   "end": 51.0,
   "text": "Жену деда звали Әсел, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.4,
   "end": 60.4,
   "text": "Дед всю жизнь дружил с соседом, его звали Виктор, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.8,
   "end": 66.4,
   "text": "У деда и Әсел родился сын Жандос, мой отец."
  },
  {
   "id": 10,
   "start": 66.8,
   "end": 71.1,
   "text": "Отец родился в 1947 году."
  },
  {
   "id": 11,
   "start": 71.5,
   "end": 78.7,
   "text": "Мою маму зовут Перизат, она вышла замуж за Жандос после института."
  },
  {
   "id": 12,
   "start": 79.1,
   "end": 84.9,
   "text": "У меня есть сестра Ақмарал, мы росли в Ақтөбе."
  },
  {
   "id": 13,
   "start": 85.3,
   "end": 91.8,
   "text": "А у Күләш своих детей было много, но я их почти не знаю."
  },
  {
   "id": 14,
   "start": 92.2,
   "end": 99.4,
   "text": "Сәуле дожила до девяноста лет, всё помнила, шежіреге жазып отырды."
  }
 ],
