{
 "id": "syn-14",
 "narrator": "Ақмарал",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Ақмарал, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.3,
   "text": "Моего прадеда звали Төлеген, он родился в 1892 году под Зайсан."
  },
  {
   "id": 2,
   "start": 15.7,
   "end": 21.0,
   "text": "Его жену, мою прабабушку, звали Нұрила."
  },
  {
   "id": 3,
   "start": 21.4,
   "end": 26.8,
   "text": "У них было двое детей: Қайрат и Қарлыға."
  },
  {
   "id": 4,
   "start": 27.2,
   "end": 33.3,
   "text": "Қайрат – это мой дед, атам, он работал почтальоном."
  },
  {
   "id": 5,
   "start": 33.7,
   "end": 41.6,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 42.0,
   "end": 46.1,
   "text": "В 1938 году он женился."
  },
  {
   "id": 7,
   "start": 46.5,
   "end": 51.6,
   "text": "Жену деда звали Күләш, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.0,
   "end": 60.9,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.3,
   "end": 67.2,
   "text": "У деда и Күләш родились сын Жақып и дочь Сәуле."
  },
  {
   "id": 10,
   "start": 67.6,
   "end": 73.2,
   "text": "Жақып – мой отец, әкем, родился в 1946 году."
  },
  {
   "id": 11,
   "start": 73.6,
   "end": 80.7,
   "text": "Мою маму зовут Әйгерім, она вышла замуж за Жақып после института."
  },
  {
   "id": 12,
   "start": 81.1,
   "end": 86.6,
   "text": "У меня есть брат Ғалым, мы росли в Зайсан."
  },
  {
   "id": 13,
   "start": 87.0,
   "end": 93.6,
   "text": "А у Қарлыға своих детей было много, но я их почти не знаю."
  }
 ],
