{
 "id": "syn-00",
 "narrator": "Нұрлан",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Нұрлан, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.1,
   "text": "Моего прадеда звали Сәкен, он родился в 1897 году под Семей."
  },
  {
   "id": 2,
   "start": 15.5,
   "end": 20.7,
   "text": "Его жену, мою прабабушку, звали Мария."
  },
  {
   "id": 3,
   "start": 21.1,
   "end": 26.3,
   "text": "У них было двое детей: Данияр и Ерлан."
  },
  {
   "id": 4,
   "start": 26.7,
   "end": 32.6,
   "text": "Данияр – это мой дед, атам, он работал чабаном."
  },
  {
   "id": 5,
   "start": 33.0,
   "end": 40.9,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.3,
   "end": 45.4,
   "text": "В 1942 году он женился."
  },
  {
   "id": 7,
   "start": 45.8,
   "end": 51.0,
   "text": "Жену деда звали Қарлыға, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.4,
   "end": 60.3,
   "text": "Дед всю жизнь дружил с соседом, его звали Олжас, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.7,
   "end": 67.0,
   "text": "У деда и Қарлыға родились сын Бауыржан и дочь Гүлнар."
  },
  {
   "id": 10,
   "start": 67.4,
   "end": 73.3,
   "text": "Бауыржан – мой отец, әкем, родился в 1955 году."
  },
  {
   "id": 11,
   "start": 73.7,
   "end": 81.1,
   "text": "Мою маму зовут Перизат, она вышла замуж за Бауыржан после института."
  },
  {
   "id": 12,
   "start": 81.5,
   "end": 87.1,
   "text": "У меня есть сестра Сәуле, мы росли в Семей."
  },
  {
   "id": 13,
   "start": 87.5,
   "end": 94.0,
   "text": "А у Ерлан своих детей было много, но я их почти не знаю."
  }
 ],
