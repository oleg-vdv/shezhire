{
 "id": "syn-18",
 "narrator": "Зәуре",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Зәуре, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.3,
   "text": "Моего прадеда звали Жандос, он родился в 1891 году под Кокпекты."
  },
  {
   "id": 2,
   "start": 15.7,
   "end": 21.0,
   "text": "Его жену, мою прабабушку, звали Динара."
  },
  {
   "id": 3,
   "start": 21.4,
   "end": 26.6,
   "text": "У них было двое детей: Нұрлан и Темір."
  },
  {
   "id": 4,
   "start": 27.0,
   "end": 32.8,
   "text": "Нұрлан – это мой дед, атам, он работал врачом."
  },
  {
   "id": 5,
   "start": 33.2,
   "end": 41.1,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.5,
   "end": 45.6,
   "text": "В 1939 году он женился."
  },
  {
   "id": 7,
   "start": 46.0,
   "end": 51.1,
   "text": "Жену деда звали Жанар, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.5,
   "end": 60.4,
   "text": "Дед всю жизнь дружил с соседом, его звали Тимур, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.8,
   "end": 66.7,
   "text": "У деда и Жанар родились сын Берік и дочь Күләш."
  },
  {
   "id": 10,
   "start": 67.1,
   "end": 72.7,
   "text": "Берік – мой отец, әкем, родился в 1941 году."
  },
  {
   "id": 11,
   "start": 73.1,
   "end": 80.2,
   "text": "Мою маму зовут Меруерт, она вышла замуж за Берік после института."
  },
  {
   "id": 12,
   "start": 80.6,
   "end": 86.3,
   "text": "У меня есть брат Болат, мы росли в Қарқаралы."
  },
  {
   "id": 13,
   "start": 86.7,
   "end": 93.2,
   "text": "А у Темір своих детей было много, но я их почти не знаю."
  }
 ],
