{
 "id": "syn-01",
 "narrator": "Динара",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Динара, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.1,
   "text": "Моего прадеда звали Ермек, он родился в 1893 году под Семей."
  },
  {
   "id": 2,
   "start": 15.5,
   "end": 20.8,
   "text": "Его жену, мою прабабушку, звали Гүлнар."
  },
  {
   "id": 3,
   "start": 21.2,
   "end": 26.8,
   "text": "У них было двое детей: Қайрат и Құдайберген."
  },
  {
   "id": 4,
   "start": 27.2,
   "end": 33.0,
   "text": "Қайрат – это мой дед, атам, он работал врачом."
  },
  {
   "id": 5,
   "start": 33.4,
   "end": 41.3,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.7,
   "end": 45.8,
   "text": "В 1944 году он женился."
  },
  {
   "id": 7,
   "start": 46.2,
   "end": 51.3,
   "text": "Жену деда звали Зәуре, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.7,
   "end": 60.6,
   "text": "Дед всю жизнь дружил с соседом, его звали Олжас, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.0,
   "end": 67.0,
   "text": "У деда и Зәуре родились сын Сәкен и дочь Перизат."
  },
  {
   "id": 10,
   "start": 67.4,
   "end": 73.0,
   "text": "Сәкен – мой отец, әкем, родился в 1944 году."
  },
  {
   "id": 11,
   "start": 73.4,
   "end": 80.4,
   "text": "Мою маму зовут Мария, она вышла замуж за Сәкен после института."
  },
  {
   "id": 12,
   "start": 80.8,
   "end": 86.3,
   "text": "У меня есть брат Ғалым, мы росли в Ақтөбе."
  },
  {
   "id": 13,
   "start": 86.7,
   "end": 93.6,
   "text": "А у Құдайберген своих детей было много, но я их почти не знаю."
  }
 ],
