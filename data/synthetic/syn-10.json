{
 "id": "syn-10",
 "narrator": "Қарлыға",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Қарлыға, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.6,
   "text": "Моего прадеда звали Құдайберген, он родился в 1902 году под Зайсан."
  },
  {
   "id": 2,
   "start": 16.0,
   "end": 21.4,
   "text": "Его жену, мою прабабушку, звали Перизат."
  },
  {
   "id": 3,
   "start": 21.8,
   "end": 26.9,
   "text": "У них было двое детей: Асқар и Роза."
  },
  {
   "id": 4,
   "start": 27.3,
   "end": 33.4,
   "text": "Асқар – это мой дед, атам, он работал трактористом."
  },
  {
   "id": 5,
   "start": 33.8,
   "end": 41.7,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 42.1,
   "end": 46.2,
   "text": "В 1950 году он женился."
  },
  {
   "id": 7,
   "start": 46.6,
   "end": 51.7,
   "text": "Жену деда звали Айгүл, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.1,
   "end": 61.1,
   "text": "Дед всю жизнь дружил с соседом, его звали Виктор, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.5,
   "end": 67.5,
   "text": "У деда и Айгүл родились сын Берік и дочь Әйгерім."
  },
  {
   "id": 10,
   "start": 67.9,
   "end": 73.5,
   "text": "Берік – мой отец, әкем, родился в 1958 году."
  },
  {
   "id": 11,
   "start": 73.9,
   "end": 81.0,
   "text": "Мою маму зовут Ақмарал, она вышла замуж за Берік после института."
  },
  {
   "id": 12,
   "start": 81.4,
   "end": 87.1,
   "text": "У меня есть сестра Гүлнар, мы росли в Зайсан."
  },
  {
   "id": 13,
   "start": 87.5,
   "end": 93.9,
   "text": "А у Роза своих детей было много, но я их почти не знаю."
  }
 ],
