{
 "id": "syn-24",
 "narrator": "Серік",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Серік, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.2,
   "text": "Моего прадеда звали Мұрат, он родился в 1899 году под Павлодар."
  },
  {
   "id": 2,
   "start": 15.6,
   "end": 21.0,
   "text": "Его жену, мою прабабушку, звали Ақмарал."
  },
  {
   "id": 3,
   "start": 21.4,
   "end": 26.7,
   "text": "У них было двое детей: Нұржан и Нұрила."
  },
  {
   "id": 4,
   "start": 27.1,
   "end": 33.0,
   "text": "Нұржан – это мой дед, атам, он работал учителем."
  },
  {
   "id": 5,
   "start": 33.4,
   "end": 41.3,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.7,
   "end": 45.8,
   "text": "В 1950 году он женился."
  },
  {
   "id": 7,
   "start": 46.2,
   "end": 51.3,
   "text": "Жену деда звали Шолпан, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.7,
   "end": 60.6,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.0,
   "end": 66.9,
   "text": "У деда и Шолпан родились сын Ерлан и дочь Жанар."
  },
  {
   "id": 10,
   "start": 67.3,
   "end": 72.9,
   "text": "Ерлан – мой отец, әкем, родился в 1951 году."
  },
  {
   "id": 11,
   "start": 73.3,
   "end": 80.4,
   "text": "Мою маму зовут Гүлнар, она вышла замуж за Ерлан после института."
  },
  {
   "id": 12,
   "start": 80.8,
   "end": 86.4,
   "text": "У меня есть сестра Зәуре, мы росли в Аягөз."
  },
  {
   "id": 13,
   "start": 86.8,
   "end": 93.4,
   "text": "А у Нұрила своих детей было много, но я их почти не знаю."
  }
 ],
