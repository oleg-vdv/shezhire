{
 "id": "syn-07",
 "narrator": "Перизат",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Перизат, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.2,
   "text": "Моего прадеда звали Серік, он родился в 1905 году под Зайсан."
  },
  {
   "id": 2,
   "start": 15.6,
   "end": 20.7,
   "text": "Его жену, мою прабабушку, звали Роза."
  },
  {
   "id": 3,
   "start": 21.1,
   "end": 26.3,
   "text": "У них было двое детей: Мақсат и Ерлан."
  },
  {
   "id": 4,
   "start": 26.7,
   "end": 32.6,
   "text": "Мақсат – это мой дед, атам, он работал чабаном."
  },
  {
   "id": 5,
   "start": 33.0,
   "end": 40.9,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.3,
   "end": 45.4,
   "text": "В 1957 году он женился."
  },
  {
   "id": 7,
   "start": 45.8,
   "end": 50.9,
   "text": "Жену деда звали Күләш, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.3,
   "end": 60.2,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.6,
   "end": 66.4,
   "text": "У деда и Күләш родились сын Арман и дочь Әсел."
  },
  {
   "id": 10,
   "start": 66.8,
   "end": 72.4,
   "text": "Арман – мой отец, әкем, родился в 1959 году."
  },
  {
   "id": 11,
   "start": 72.8,
   "end": 79.9,
   "text": "Мою маму зовут Әйгерім, она вышла замуж за Арман после института."
  },
  {
   "id": 12,
   "start": 80.3,
   "end": 86.2,
   "text": "У меня есть сестра Динара, мы росли в Түркістан."
  },
  {
   "id": 13,
   "start": 86.6,
   "end": 93.1,
   "text": "А у Ерлан своих детей было много, но я их почти не знаю."
  },
  {
   "id": 14,
   "start": 93.5,
   "end": 100.6,
   "text": "Роза дожила до девяноста лет, всё помнила, шежіреге жазып отырды."
  }
 ],
