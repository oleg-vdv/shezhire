{
 "id": "syn-28",
 "narrator": "Ахмет",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Ахмет, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.4,
   "text": "Моего прадеда звали Әбдірахман, он родился в 1901 году под Ақтөбе."
  },
  {
   "id": 2,
   "start": 15.8,
   "end": 21.0,
   "text": "Его жену, мою прабабушку, звали Айгүл."
  },
  {
   "id": 3,
   "start": 21.4,
   "end": 26.5,
   "text": "У них было двое детей: Болат и Әсел."
  },
  {
   "id": 4,
   "start": 26.9,
   "end": 32.6,
   "text": "Болат – это мой дед, атам, он работал врачом."
  },
  {
   "id": 5,
   "start": 33.0,
   "end": 40.9,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.3,
   "end": 45.4,
   "text": "В 1956 году он женился."
  },
  {
   "id": 7,
   "start": 45.8,
   "end": 50.9,
   "text": "Жену деда звали Гүлнар, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.3,
   "end": 60.3,
   "text": "Дед всю жизнь дружил с соседом, его звали Виктор, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.7,
   "end": 66.8,
   "text": "У деда и Гүлнар родились сын Темір и дочь Меруерт."
  },
  {
   "id": 10,
   "start": 67.2,
   "end": 72.8,
   "text": "Темір – мой отец, әкем, родился в 1957 году."
  },
  {
   "id": 11,
   "start": 73.2,
   "end": 80.2,
   "text": "Мою маму зовут Күләш, она вышла замуж за Темір после института."
  },
  {
   "id": 12,
   "start": 80.6,
   "end": 86.2,
   "text": "У меня есть сестра Зәуре, мы росли в Семей."
  },
  {
   "id": 13,
   "start": 86.6,
   "end": 93.0,
   "text": "А у Әсел своих детей было много, но я их почти не знаю."
  }
 ],
