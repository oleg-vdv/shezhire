{
 "id": "syn-21",
 "narrator": "Серік",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Серік, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.0,
   "text": "Моего прадеда звали Асқар, он родился в 1902 году под Семей."
  },
  {
   "id": 2,
   "start": 15.4,
   "end": 20.6,
   "text": "Его жену, мою прабабушку, звали Жанар."
  },
  {
   "id": 3,
   "start": 21.0,
   "end": 26.2,
   "text": "У них было двое детей: Данияр и Оспан."
  },
  {
   "id": 4,
   "start": 26.6,
   "end": 33.5,
   "text": "Данияр – это мой дед, атам, он работал бухгалтером в совхозе."
  },
  {
   "id": 5,
   "start": 33.9,
   "end": 41.8,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 42.2,
   "end": 46.3,
   "text": "В 1952 году он женился."
  },
  {
   "id": 7,
   "start": 46.7,
   "end": 51.8,
   "text": "Жену деда звали Динара, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.2,
   "end": 61.2,
   "text": "Дед всю жизнь дружил с соседом, его звали Сергей, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.6,
   "end": 67.7,
   "text": "У деда и Динара родился сын Құдайберген, мой отец."
  },
  {
   "id": 10,
   "start": 68.1,
   "end": 72.4,
   "text": "Отец родился в 1952 году."
  },
  {
   "id": 11,
   "start": 72.8,
   "end": 80.4,
   "text": "Мою маму зовут Ақмарал, она вышла замуж за Құдайберген после института."
  },
  {
   "id": 12,
   "start": 80.8,
   "end": 86.2,
   "text": "У меня есть брат Мұрат, мы росли в Аягөз."
  },
  {
   "id": 13,
   "start": 86.6,
   "end": 93.1,
   "text": "А у Оспан своих детей было много, но я их почти не знаю."
  }
 ],
