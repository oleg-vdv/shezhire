{
 "id": "syn-08",
 "narrator": "Сәуле",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Сәуле, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.2,
   "text": "Моего прадеда звали Арман, он родился в 1901 году под Кокпекты."
  },
  {
   "id": 2,
   "start": 15.6,
   "end": 20.8,
   "text": "Его жену, мою прабабушку, звали Зәуре."
  },
  {
   "id": 3,
   "start": 21.2,
   "end": 26.3,
   "text": "У них было двое детей: Жақып и Мұрат."
  },
  {
   "id": 4,
   "start": 26.7,
   "end": 32.8,
   "text": "Жақып – это мой дед, атам, он работал почтальоном."
  },
  {
   "id": 5,
   "start": 33.2,
   "end": 41.1,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.5,
   "end": 45.6,
   "text": "В 1951 году он женился."
  },
  {
   "id": 7,
   "start": 46.0,
   "end": 51.1,
   "text": "Жену деда звали Ұлжан, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.5,
   "end": 60.5,
   "text": "Дед всю жизнь дружил с соседом, его звали Сергей, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.9,
   "end": 66.9,
   "text": "У деда и Ұлжан родились сын Ермек и дочь Перизат."
  },
  {
   "id": 10,
   "start": 67.3,
   "end": 72.9,
   "text": "Ермек – мой отец, әкем, родился в 1956 году."
  },
  {
   "id": 11,
   "start": 73.3,
   "end": 80.4,
   "text": "Мою маму зовут Бибігүл, она вышла замуж за Ермек после института."
  },
  {
   "id": 12,
   "start": 80.8,
   "end": 86.5,
   "text": "У меня есть сестра Роза, мы росли в Баянауыл."
  },
  {
   "id": 13,
   "start": 86.9,
   "end": 93.4,
   "text": "А у Мұрат своих детей было много, но я их почти не знаю."
  }
 ],
