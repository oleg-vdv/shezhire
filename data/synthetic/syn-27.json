{
 "id": "syn-27",
 "narrator": "Ұлжан",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Ұлжан, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.3,
   "text": "Моего прадеда звали Ермек, он родился в 1896 году под Түркістан."
  },
  {
   "id": 2,
   "start": 15.7,
   "end": 20.8,
   "text": "Его жену, мою прабабушку, звали Әсел."
  },
  {
   "id": 3,
   "start": 21.2,
   "end": 26.7,
   "text": "У них было двое детей: Бауыржан и Меруерт."
  },
  {
   "id": 4,
   "start": 27.1,
   "end": 33.4,
   "text": "Бауыржан – это мой дед, атам, он работал почтальоном."
  },
  {
   "id": 5,
   "start": 33.8,
   "end": 41.7,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 42.1,
   "end": 46.2,
   "text": "В 1945 году он женился."
  },
  {
   "id": 7,
   "start": 46.6,
   "end": 51.8,
   "text": "Жену деда звали Әйгерім, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.2,
   "end": 61.1,
   "text": "Дед всю жизнь дружил с соседом, его звали Тимур, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.5,
   "end": 67.4,
   "text": "У деда и Әйгерім родились сын Болат и дочь Роза."
  },
  {
   "id": 10,
   "start": 67.8,
   "end": 73.4,
   "text": "Болат – мой отец, әкем, родился в 1946 году."
  },
  {
   "id": 11,
   "start": 73.8,
   "end": 80.9,
   "text": "Мою маму зовут Бибігүл, она вышла замуж за Болат после института."
  },
  {
   "id": 12,
   "start": 81.3,
   "end": 86.9,
   "text": "У меня есть сестра Айгүл, мы росли в Ақтөбе."
  },
  {
   "id": 13,
   "start": 87.3,
   "end": 93.9,
   "text": "А у Меруерт своих детей было много, но я их почти не знаю."
  }
 ],
