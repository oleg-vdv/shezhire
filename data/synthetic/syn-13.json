{
 "id": "syn-13",
 "narrator": "Құдайберген",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 8.2,
   "text": "Меня зовут Құдайберген, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.6,
   "end": 15.6,
   "text": "Моего прадеда звали Сәкен, он родился в 1904 году под Кокпекты."
  },
  {
   "id": 2,
   "start": 16.0,
   "end": 21.3,
   "text": "Его жену, мою прабабушку, звали Нұрила."
  },
  {
   "id": 3,
   "start": 21.7,
   "end": 26.8,
   "text": "У них было двое детей: Оспан и Сәуле."
  },
  {
   "id": 4,
   "start": 27.2,
   "end": 32.9,
   "text": "Оспан – это мой дед, атам, он работал врачом."
  },
  {
   "id": 5,
   "start": 33.3,
   "end": 41.2,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.6,
   "end": 45.7,
   "text": "В 1955 году он женился."
  },
  {
   "id": 7,
   "start": 46.1,
   "end": 51.3,
   "text": "Жену деда звали Перизат, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.7,
   "end": 60.6,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.0,
   "end": 67.0,
   "text": "У деда и Перизат родились сын Нұрлан и дочь Әсел."
  },
  {
   "id": 10,
   "start": 67.4,
   "end": 73.1,
   "text": "Нұрлан – мой отец, әкем, родился в 1962 году."
  },
  {
   "id": 11,
   "start": 73.5,
   "end": 80.6,
   "text": "Мою маму зовут Гүлнар, она вышла замуж за Нұрлан после института."
  },
  {
   "id": 12,
   "start": 81.0,
   "end": 86.6,
   "text": "У меня есть брат Серік, мы росли в Павлодар."
  },
  {
   "id": 13,
   "start": 87.0,
   "end": 93.5,
   "text": "А у Сәуле своих детей было много, но я их почти не знаю."
  }
 ],
