{
 "id": "syn-12",
 "narrator": "Күләш",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Күләш, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.4,
   "text": "Моего прадеда звали Әбдірахман, он родился в 1895 году под Зайсан."
  },
  {
   "id": 2,
   "start": 15.8,
   "end": 21.0,
   "text": "Его жену, мою прабабушку, звали Жанар."
  },
  {
   "id": 3,
   "start": 21.4,
   "end": 26.5,
   "text": "У них было двое детей: Темір и Мария."
  },
  {
   "id": 4,
   "start": 26.9,
   "end": 33.0,
   "text": "Темір – это мой дед, атам, он работал трактористом."
  },
  {
   "id": 5,
   "start": 33.4,
   "end": 41.3,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.7,
   "end": 45.8,
   "text": "В 1946 году он женился."
  },
  {
   "id": 7,
   "start": 46.2,
   "end": 51.3,
   "text": "Жену деда звали Гүлнар, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.7,
   "end": 60.6,
   "text": "Дед всю жизнь дружил с соседом, его звали Олжас, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.0,
   "end": 66.6,
   "text": "У деда и Гүлнар родился сын Ермек, мой отец."
  },
  {
   "id": 10,
   "start": 67.0,
   "end": 71.3,
   "text": "Отец родился в 1945 году."
  },
  {
   "id": 11,
   "start": 71.7,
   "end": 78.8,
   "text": "Мою маму зовут Перизат, она вышла замуж за Ермек после института."
  },
  {
   "id": 12,
   "start": 79.2,
   "end": 84.6,
   "text": "У меня есть брат Жақып, мы росли в Аягөз."
  },
  {
   "id": 13,
   "start": 85.0,
   "end": 91.5,
   "text": "А у Мария своих детей было много, но я их почти не знаю."
  }
 ],
