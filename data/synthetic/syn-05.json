{
 "id": "syn-05",
 "narrator": "Оспан",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Оспан, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.1,
   "text": "Моего прадеда звали Данияр, он родился в 1895 году под Зайсан."
  },
  {
   "id": 2,
   "start": 15.5,
   "end": 20.6,
   "text": "Его жену, мою прабабушку, звали Роза."
  },
  {
   "id": 3,
   "start": 21.0,
   "end": 26.3,
   "text": "У них было двое детей: Арман и Ақмарал."
  },
  {
   "id": 4,
   "start": 26.7,
   "end": 32.6,
   "text": "Арман – это мой дед, атам, он работал агрономом."
  },
  {
   "id": 5,
   "start": 33.0,
   "end": 40.9,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.3,
   "end": 45.4,
   "text": "В 1945 году он женился."
  },
  {
   "id": 7,
   "start": 45.8,
   "end": 50.9,
   "text": "Жену деда звали Мария, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.3,
   "end": 60.2,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.6,
   "end": 66.4,
   "text": "У деда и Мария родились сын Ерлан и дочь Әсел."
  },
  {
   "id": 10,
   "start": 66.8,
   "end": 72.4,
   "text": "Ерлан – мой отец, әкем, родился в 1949 году."
  },
  {
   "id": 11,
   "start": 72.8,
   "end": 79.8,
   "text": "Мою маму зовут Жанар, она вышла замуж за Ерлан после института."
  },
  {
   "id": 12,
   "start": 80.2,
   "end": 86.8,
   "text": "А у Ақмарал своих детей было много, но я их почти не знаю."
  }
 ],
