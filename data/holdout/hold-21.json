 "narrator": "Болат",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Болат, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.1,
   "text": "Моего прадеда звали Данияр, он родился в 1901 году под Зайсан."
  },
  {
   "id": 2,
   "start": 15.5,
   "end": 20.8,
   "text": "Его жену, мою прабабушку, звали Нұрила."
  },
  {
   "id": 3,
   "start": 21.2,
   "end": 26.7,
   "text": "У них было двое детей: Әбдірахман и Жанар."
  },
  {
   "id": 4,
   "start": 27.1,
   "end": 33.2,
   "text": "Әбдірахман – это мой дед, атам, он работал шофёром."
  },
  {
   "id": 5,
   "start": 33.6,
   "end": 41.5,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.9,
   "end": 46.0,
   "text": "В 1953 году он женился."
  },
  {
   "id": 7,
   "start": 46.4,
   "end": 51.5,
   "text": "Жену деда звали Ұлжан, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.9,
   "end": 60.8,
   "text": "Дед всю жизнь дружил с соседом, его звали Олжас, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.2,
   "end": 67.1,
   "text": "У деда и Ұлжан родились сын Ермек и дочь Күләш."
  },
  {
   "id": 10,
   "start": 67.5,
   "end": 73.1,
   "text": "Ермек – мой отец, әкем, родился в 1957 году."
  },
  {
   "id": 11,
   "start": 73.5,
   "end": 80.6,
   "text": "Мою маму зовут Қарлыға, она вышла замуж за Ермек после института."
  },
  {
   "id": 12,
   "start": 81.0,
   "end": 87.5,
   "text": "А у Жанар своих детей было много, но я их почти не знаю."
  }
 ],
