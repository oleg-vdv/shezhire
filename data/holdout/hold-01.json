{
 "id": "hold-01",
 "narrator": "Арман",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Арман, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.2,
   "text": "Моего прадеда звали Болат, он родился в 1904 году под Баянауыл."
  },
  {
   "id": 2,
   "start": 15.6,
   "end": 20.7,
   "text": "Его жену, мою прабабушку, звали Роза."
  },
  {
   "id": 3,
   "start": 21.1,
   "end": 26.3,
   "text": "У них было двое детей: Данияр и Сәкен."
  },
  {
   "id": 4,
   "start": 26.7,
   "end": 32.6,
   "text": "Данияр – это мой дед, атам, он работал шофёром."
  },
  {
   "id": 5,
   "start": 33.0,
   "end": 40.9,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.3,
   "end": 45.4,
   "text": "В 1957 году он женился."
  },
  {
   "id": 7,
   "start": 45.8,
   "end": 50.9,
   "text": "Жену деда звали Айгүл, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.3,
   "end": 60.3,
   "text": "Дед всю жизнь дружил с соседом, его звали Виктор, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.7,
   "end": 66.6,
   "text": "У деда и Айгүл родились сын Мақсат и дочь Жанар."
  },
  {
   "id": 10,
   "start": 67.0,
   "end": 72.7,
   "text": "Мақсат – мой отец, әкем, родился в 1955 году."
  },
  {
   "id": 11,
   "start": 73.1,
   "end": 80.2,
   "text": "Мою маму зовут Ұлжан, она вышла замуж за Мақсат после института."
  },
  {
   "id": 12,
   "start": 80.6,
   "end": 86.4,
   "text": "У меня есть сестра Әйгерім, мы росли в Ақтөбе."
  },
  {
   "id": 13,
   "start": 86.8,
   "end": 93.3,
   "text": "А у Сәкен своих детей было много, но я их почти не знаю."
  }
 ],
