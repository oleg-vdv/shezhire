{
 "id": "hold-28",
 "narrator": "Құдайберген",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 8.2,
   "text": "Меня зовут Құдайберген, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.6,
   "end": 15.6,
   "text": "Моего прадеда звали Жандос, он родился в 1905 году под Шымкент."
  },
  {
   "id": 2,
   "start": 16.0,
   "end": 21.3,
   "text": "Его жену, мою прабабушку, звали Динара."
  },
  {
   "id": 3,
   "start": 21.7,
   "end": 26.8,
   "text": "У них было двое детей: Оспан и Сәуле."
  },
  {
   "id": 4,
   "start": 27.2,
   "end": 33.3,
   "text": "Оспан – это мой дед, атам, он работал почтальоном."
  },
  {
   "id": 5,
   "start": 33.7,
   "end": 41.6,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 42.0,
   "end": 46.1,
   "text": "В 1955 году он женился."
  },
  {
   "id": 7,
   "start": 46.5,
   "end": 51.7,
   "text": "Жену деда звали Ақмарал, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.1,
   "end": 61.0,
   "text": "Дед всю жизнь дружил с соседом, его звали Тимур, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.4,
   "end": 67.3,
   "text": "У деда и Ақмарал родились сын Асқар и дочь Әсел."
  },
  {
   "id": 10,
   "start": 67.7,
   "end": 73.3,
   "text": "Асқар – мой отец, әкем, родился в 1963 году."
  },
  {
   "id": 11,
   "start": 73.7,
   "end": 80.7,
   "text": "Мою маму зовут Ұлжан, она вышла замуж за Асқар после института."
  },
  {
   "id": 12,
   "start": 81.1,
   "end": 87.0,
   "text": "У меня есть сестра Нұрила, мы росли в Кокпекты."
  },
  {
   "id": 13,
   "start": 87.4,
   "end": 93.9,
   "text": "А у Сәуле своих детей было много, но я их почти не знаю."
  }
 ],
