{
 "id": "hold-04",
 "narrator": "Меруерт",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Меруерт, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.3,
   "text": "Моего прадеда звали Мұрат, он родился в 1898 году под Павлодар."
  },
  {
   "id": 2,
   "start": 15.7,
   "end": 21.0,
   "text": "Его жену, мою прабабушку, звали Динара."
  },
  {
   "id": 3,
   "start": 21.4,
   "end": 26.6,
   "text": "У них было двое детей: Берік и Балжан."
  },
  {
   "id": 4,
   "start": 27.0,
   "end": 32.8,
   "text": "Берік – это мой дед, атам, он работал чабаном."
  },
  {
   "id": 5,
   "start": 33.2,
   "end": 41.1,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.5,
   "end": 45.6,
   "text": "В 1950 году он женился."
  },
  {
   "id": 7,
   "start": 46.0,
   "end": 51.2,
   "text": "Жену деда звали Қарлыға, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.6,
   "end": 60.5,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.9,
   "end": 66.6,
   "text": "У деда и Қарлыға родился сын Жақып, мой отец."
  },
  {
   "id": 10,
   "start": 67.0,
   "end": 71.3,
   "text": "Отец родился в 1950 году."
  },
  {
   "id": 11,
   "start": 71.7,
   "end": 78.8,
   "text": "Мою маму зовут Гүлнар, она вышла замуж за Жақып после института."
  },
  {
   "id": 12,
   "start": 79.2,
   "end": 85.0,
   "text": "У меня есть брат Төлеген, мы росли в Павлодар."
  },
  {
   "id": 13,
   "start": 85.4,
   "end": 92.0,
   "text": "А у Балжан своих детей было много, но я их почти не знаю."
  },
  {
   "id": 14,
   "start": 92.4,
   "end": 99.7,
   "text": "Динара дожила до девяноста лет, всё помнила, шежіреге жазып отырды."
  }
 ],
