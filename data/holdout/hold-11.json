{
 "id": "hold-11",
 "narrator": "Жанар",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Жанар, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.1,
   "text": "Моего прадеда звали Данияр, он родился в 1900 году под Аягөз."
  },
  {
   "id": 2,
   "start": 15.5,
   "end": 20.7,
   "text": "Его жену, мою прабабушку, звали Зәуре."
  },
  {
   "id": 3,
   "start": 21.1,
   "end": 26.2,
   "text": "У них было двое детей: Серік и Ермек."
  },
  {
   "id": 4,
   "start": 26.6,
   "end": 32.5,
   "text": "Серік – это мой дед, атам, он работал учителем."
  },
  {
   "id": 5,
   "start": 32.9,
   "end": 40.8,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.2,
   "end": 45.3,
   "text": "В 1948 году он женился."
  },
  {
   "id": 7,
   "start": 45.7,
   "end": 50.8,
   "text": "Жену деда звали Күләш, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.2,
   "end": 60.1,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.5,
   "end": 66.1,
   "text": "У деда и Күләш родился сын Берік, мой отец."
  },
  {
   "id": 10,
   "start": 66.5,
   "end": 70.8,
   "text": "Отец родился в 1954 году."
  },
  {
   "id": 11,
   "start": 71.2,
   "end": 78.3,
   "text": "Мою маму зовут Қарлыға, она вышла замуж за Берік после института."
  },
  {
   "id": 12,
   "start": 78.7,
   "end": 84.2,
   "text": "У меня есть брат Сәкен, мы росли в Ақтөбе."
  },
  {
   "id": 13,
   "start": 84.6,
   "end": 91.1,
   "text": "А у Ермек своих детей было много, но я их почти не знаю."
  }
 ],
