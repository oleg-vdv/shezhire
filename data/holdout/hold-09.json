{
 "id": "hold-09",
 "narrator": "Гүлнар",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Гүлнар, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.1,
   "text": "Моего прадеда звали Болат, он родился в 1893 году под Семей."
  },
  {
   "id": 2,
   "start": 15.5,
   "end": 20.7,
   "text": "Его жену, мою прабабушку, звали Зәуре."
  },
  {
   "id": 3,
   "start": 21.1,
   "end": 26.3,
   "text": "У них было двое детей: Темір и Нұрила."
  },
  {
   "id": 4,
   "start": 26.7,
   "end": 32.5,
   "text": "Темір – это мой дед, атам, он работал чабаном."
  },
  {
   "id": 5,
   "start": 32.9,
   "end": 40.8,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.2,
   "end": 45.3,
   "text": "В 1946 году он женился."
  },
  {
   "id": 7,
   "start": 45.7,
   "end": 50.9,
   "text": "Жену деда звали Әйгерім, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.3,
   "end": 60.2,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.6,
   "end": 66.5,
   "text": "У деда и Әйгерім родились сын Сәкен и дочь Роза."
  },
  {
   "id": 10,
   "start": 66.9,
   "end": 72.5,
   "text": "Сәкен – мой отец, әкем, родился в 1946 году."
  },
  {
   "id": 11,
   "start": 72.9,
   "end": 80.0,
   "text": "Мою маму зовут Перизат, она вышла замуж за Сәкен после института."
  },
  {
   "id": 12,
   "start": 80.4,
   "end": 86.2,
   "text": "У меня есть сестра Қарлыға, мы росли в Ақтөбе."
  },
  {
   "id": 13,
   "start": 86.6,
   "end": 93.2,
   "text": "А у Нұрила своих детей было много, но я их почти не знаю."
  }
 ],
