{
 "id": "hold-08",
 "narrator": "Мақсат",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Мақсат, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.3,
   "text": "Моего прадеда звали Мұрат, он родился в 1895 году под Кокпекты."
  },
  {
   "id": 2,
   "start": 15.7,
   "end": 20.9,
   "text": "Его жену, мою прабабушку, звали Зәуре."
  },
  {
   "id": 3,
   "start": 21.3,
   "end": 26.5,
   "text": "У них было двое детей: Нұрлан и Жақып."
  },
  {
   "id": 4,
   "start": 26.9,
   "end": 32.9,
   "text": "Нұрлан – это мой дед, атам, он работал агрономом."
  },
  {
   "id": 5,
   "start": 33.3,
   "end": 41.2,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.6,
   "end": 45.7,
   "text": "В 1948 году он женился."
  },
  {
   "id": 7,
   "start": 46.1,
   "end": 51.3,
   "text": "Жену деда звали Ақмарал, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.7,
   "end": 60.7,
   "text": "Дед всю жизнь дружил с соседом, его звали Виктор, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.1,
   "end": 67.2,
   "text": "У деда и Ақмарал родился сын Әбдірахман, мой отец."
  },
  {
   "id": 10,
   "start": 67.6,
   "end": 71.9,
   "text": "Отец родился в 1949 году."
  },
  {
   "id": 11,
   "start": 72.3,
   "end": 79.8,
   "text": "Мою маму зовут Бибігүл, она вышла замуж за Әбдірахман после института."
  },
  {
   "id": 12,
   "start": 80.2,
   "end": 85.8,
   "text": "У меня есть брат Қайрат, мы росли в Ақтөбе."
  },
  {
   "id": 13,
   "start": 86.2,
   "end": 92.7,
   "text": "А у Жақып своих детей было много, но я их почти не знаю."
  },
  {
   "id": 14,
   "start": 93.1,
   "end": 100.3,
   "text": "Зәуре дожила до девяноста лет, всё помнила, шежіреге жазып отырды."
  }
 ],
