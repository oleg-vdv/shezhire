{
 "id": "hold-02",
 "narrator": "Нұрлан",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Нұрлан, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.6,
   "text": "Моего прадеда звали Құдайберген, он родился в 1893 году под Зайсан."
  },
  {
   "id": 2,
   "start": 16.0,
   "end": 21.3,
   "text": "Его жену, мою прабабушку, звали Балжан."
  },
  {
   "id": 3,
   "start": 21.7,
   "end": 26.9,
   "text": "У них было двое детей: Ермек и Шолпан."
  },
  {
   "id": 4,
   "start": 27.3,
   "end": 33.1,
   "text": "Ермек – это мой дед, атам, он работал шофёром."
  },
  {
   "id": 5,
   "start": 33.5,
   "end": 41.4,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.8,
   "end": 45.9,
   "text": "В 1943 году он женился."
  },
  {
   "id": 7,
   "start": 46.3,
   "end": 51.4,
   "text": "Жену деда звали Ұлжан, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.8,
   "end": 60.8,
   "text": "Дед всю жизнь дружил с соседом, его звали Виктор, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.2,
   "end": 67.2,
   "text": "У деда и Ұлжан родились сын Оспан и дочь Бибігүл."
  },
  {
   "id": 10,
   "start": 67.6,
   "end": 73.2,
   "text": "Оспан – мой отец, әкем, родился в 1949 году."
  },
  {
   "id": 11,
   "start": 73.6,
   "end": 80.7,
   "text": "Мою маму зовут Динара, она вышла замуж за Оспан после института."
  },
  {
   "id": 12,
   "start": 81.1,
   "end": 87.7,
   "text": "А у Шолпан своих детей было много, но я их почти не знаю."
  }
 ],
