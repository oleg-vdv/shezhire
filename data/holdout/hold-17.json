{
 "id": "hold-17",
 "narrator": "Асқар",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Асқар, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.1,
   "text": "Моего прадеда звали Жақып, он родился в 1902 году под Зайсан."
  },
  {
   "id": 2,
   "start": 15.5,
   "end": 20.8,
   "text": "Его жену, мою прабабушку, звали Шолпан."
  },
  {
   "id": 3,
   "start": 21.2,
   "end": 26.4,
   "text": "У них было двое детей: Нұрлан и Серік."
  },
  {
   "id": 4,
   "start": 26.8,
   "end": 32.7,
   "text": "Нұрлан – это мой дед, атам, он работал чабаном."
  },
  {
   "id": 5,
   "start": 33.1,
   "end": 41.0,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.4,
   "end": 45.5,
   "text": "В 1949 году он женился."
  },
  {
   "id": 7,
   "start": 45.9,
   "end": 50.9,
   "text": "Жену деда звали Әсел, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.3,
   "end": 60.3,
   "text": "Дед всю жизнь дружил с соседом, его звали Сергей, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.7,
   "end": 66.6,
   "text": "У деда и Әсел родились сын Данияр и дочь Динара."
  },
  {
   "id": 10,
   "start": 67.0,
   "end": 72.7,
   "text": "Данияр – мой отец, әкем, родился в 1960 году."
  },
  {
   "id": 11,
   "start": 73.1,
   "end": 80.2,
   "text": "Мою маму зовут Мария, она вышла замуж за Данияр после института."
  },
  {
   "id": 12,
   "start": 80.6,
   "end": 86.3,
   "text": "У меня есть сестра Гүлнар, мы росли в Ақтөбе."
  },
  {
   "id": 13,
   "start": 86.7,
   "end": 93.2,
   "text": "А у Серік своих детей было много, но я их почти не знаю."
  },
  {
   "id": 14,
   "start": 93.6,
   "end": 100.9,
   "text": "Шолпан дожила до девяноста лет, всё помнила, шежіреге жазып отырды."
  }
 ],
