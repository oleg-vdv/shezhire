{
 "id": "hold-29",
 "narrator": "Динара",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Динара, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.2,
   "text": "Моего прадеда звали Оспан, он родился в 1904 году под Зайсан."
  },
  {
   "id": 2,
   "start": 15.6,
   "end": 20.8,
   "text": "Его жену, мою прабабушку, звали Күләш."
  },
  {
   "id": 3,
   "start": 21.2,
   "end": 26.6,
   "text": "У них было двое детей: Бауыржан и Жандос."
  },
  {
   "id": 4,
   "start": 27.0,
   "end": 33.4,
   "text": "Бауыржан – это мой дед, атам, он работал трактористом."
  },
  {
   "id": 5,
   "start": 33.8,
   "end": 41.7,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 42.1,
   "end": 46.2,
   "text": "В 1952 году он женился."
  },
  {
   "id": 7,
   "start": 46.6,
   "end": 51.7,
   "text": "Жену деда звали Мария, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.1,
   "end": 61.0,
   "text": "Дед всю жизнь дружил с соседом, его звали Олжас, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.4,
   "end": 67.4,
   "text": "У деда и Мария родились сын Нұржан и дочь Гүлнар."
  },
  {
   "id": 10,
   "start": 67.8,
   "end": 73.5,
   "text": "Нұржан – мой отец, әкем, родился в 1956 году."
  },
  {
   "id": 11,
   "start": 73.9,
   "end": 80.9,
   "text": "Мою маму зовут Роза, она вышла замуж за Нұржан после института."
  },
  {
   "id": 12,
   "start": 81.3,
   "end": 87.1,
   "text": "У меня есть сестра Сәуле, мы росли в Павлодар."
  },
  {
   "id": 13,
   "start": 87.5,
   "end": 94.1,
   "text": "А у Жандос своих детей было много, но я их почти не знаю."
  }
 ],
