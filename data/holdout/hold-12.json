{
 "id": "hold-12",
 "narrator": "Ұлжан",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Ұлжан, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.3,
   "text": "Моего прадеда звали Нұрлан, он родился в 1900 году под Павлодар."
  },
  {
   "id": 2,
   "start": 15.7,
   "end": 20.9,
   "text": "Его жену, мою прабабушку, звали Сәуле."
  },
  {
   "id": 3,
   "start": 21.3,
   "end": 26.4,
   "text": "У них было двое детей: Темір и Болат."
  },
  {
   "id": 4,
   "start": 26.8,
   "end": 32.7,
   "text": "Темір – это мой дед, атам, он работал агрономом."
  },
  {
   "id": 5,
   "start": 33.1,
   "end": 41.0,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.4,
   "end": 45.5,
   "text": "В 1953 году он женился."
  },
  {
   "id": 7,
   "start": 45.9,
   "end": 51.0,
   "text": "Жену деда звали Мария, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.4,
   "end": 60.4,
   "text": "Дед всю жизнь дружил с соседом, его звали Виктор, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.8,
   "end": 66.6,
   "text": "У деда и Мария родился сын Бауыржан, мой отец."
  },
  {
   "id": 10,
   "start": 67.0,
   "end": 71.3,
   "text": "Отец родился в 1953 году."
  },
  {
   "id": 11,
   "start": 71.7,
   "end": 79.0,
   "text": "Мою маму зовут Шолпан, она вышла замуж за Бауыржан после института."
  },
  {
   "id": 12,
   "start": 79.4,
   "end": 85.0,
   "text": "У меня есть брат Жақып, мы росли в Шымкент."
  },
  {
   "id": 13,
   "start": 85.4,
   "end": 91.9,
   "text": "А у Болат своих детей было много, но я их почти не знаю."
  }
 ],
