{
 "id": "hold-06",
 "narrator": "Әсел",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.7,
   "text": "Меня зовут Әсел, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.1,
   "end": 15.3,
   "text": "Моего прадеда звали Әбдірахман, он родился в 1896 году под Ақтөбе."
  },
  {
   "id": 2,
   "start": 15.7,
   "end": 20.9,
   "text": "Его жену, мою прабабушку, звали Мария."
  },
  {
   "id": 3,
   "start": 21.3,
   "end": 26.5,
   "text": "У них было двое детей: Мақсат и Айгүл."
  },
  {
   "id": 4,
   "start": 26.9,
   "end": 32.8,
   "text": "Мақсат – это мой дед, атам, он работал чабаном."
  },
  {
   "id": 5,
   "start": 33.2,
   "end": 41.1,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.5,
   "end": 45.6,
   "text": "В 1943 году он женился."
  },
  {
   "id": 7,
   "start": 46.0,
   "end": 51.1,
   "text": "Жену деда звали Балжан, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.5,
   "end": 60.4,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.8,
   "end": 66.7,
   "text": "У деда и Балжан родились сын Берік и дочь Күләш."
  },
  {
   "id": 10,
   "start": 67.1,
   "end": 72.7,
   "text": "Берік – мой отец, әкем, родился в 1946 году."
  },
  {
   "id": 11,
   "start": 73.1,
   "end": 80.2,
   "text": "Мою маму зовут Меруерт, она вышла замуж за Берік после института."
  },
  {
   "id": 12,
   "start": 80.6,
   "end": 87.1,
   "text": "А у Айгүл своих детей было много, но я их почти не знаю."
  }
 ],
