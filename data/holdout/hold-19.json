{
 "id": "hold-19",
 "narrator": "Мария",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Мария, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.0,
   "text": "Моего прадеда звали Сәкен, он родился в 1894 году под Аягөз."
  },
  {
   "id": 2,
   "start": 15.4,
   "end": 20.6,
   "text": "Его жену, мою прабабушку, звали Ұлжан."
  },
  {
   "id": 3,
   "start": 21.0,
   "end": 26.4,
   "text": "У них было двое детей: Бауыржан и Асқар."
  },
  {
   "id": 4,
   "start": 26.8,
   "end": 33.1,
   "text": "Бауыржан – это мой дед, атам, он работал почтальоном."
  },
  {
   "id": 5,
   "start": 33.5,
   "end": 41.4,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.8,
   "end": 45.9,
   "text": "В 1945 году он женился."
  },
  {
   "id": 7,
   "start": 46.3,
   "end": 51.4,
   "text": "Жену деда звали Сәуле, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.8,
   "end": 60.8,
   "text": "Дед всю жизнь дружил с соседом, его звали Виктор, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.2,
   "end": 67.2,
   "text": "У деда и Сәуле родился сын Құдайберген, мой отец."
  },
  {
   "id": 10,
   "start": 67.6,
   "end": 71.9,
   "text": "Отец родился в 1947 году."
  },
  {
   "id": 11,
   "start": 72.3,
   "end": 79.9,
   "text": "Мою маму зовут Бибігүл, она вышла замуж за Құдайберген после института."
  },
  {
   "id": 12,
   "start": 80.3,
   "end": 85.8,
   "text": "У меня есть брат Нұржан, мы росли в Аягөз."
  },
  {
   "id": 13,
   "start": 86.2,
   "end": 92.7,
   "text": "А у Асқар своих детей было много, но я их почти не знаю."
  },
  {
   "id": 14,
   "start": 93.1,
   "end": 100.3,
   "text": "Ұлжан дожила до девяноста лет, всё помнила, шежіреге жазып отырды."
  }
 ],
