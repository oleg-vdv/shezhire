{
 "id": "hold-16",
 "narrator": "Данияр",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Данияр, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.2,
   "text": "Моего прадеда звали Қайрат, он родился в 1899 году под Ақтөбе."
  },
  {
   "id": 2,
   "start": 15.6,
   "end": 20.9,
   "text": "Его жену, мою прабабушку, звали Нұрила."
  },
  {
   "id": 3,
   "start": 21.3,
   "end": 26.6,
   "text": "У них было двое детей: Бауыржан и Роза."
  },
  {
   "id": 4,
   "start": 27.0,
   "end": 33.4,
   "text": "Бауыржан – это мой дед, атам, он работал трактористом."
  },
  {
   "id": 5,
   "start": 33.8,
   "end": 41.7,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 42.1,
   "end": 46.2,
   "text": "В 1947 году он женился."
  },
  {
   "id": 7,
   "start": 46.6,
   "end": 51.8,
   "text": "Жену деда звали Ақмарал, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.2,
   "end": 61.2,
   "text": "Дед всю жизнь дружил с соседом, его звали Виктор, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.6,
   "end": 67.7,
   "text": "У деда и Ақмарал родился сын Құдайберген, мой отец."
  },
  {
   "id": 10,
   "start": 68.1,
   "end": 72.4,
   "text": "Отец родился в 1951 году."
  },
  {
   "id": 11,
   "start": 72.8,
   "end": 80.4,
   "text": "Мою маму зовут Меруерт, она вышла замуж за Құдайберген после института."
  },
  {
   "id": 12,
   "start": 80.8,
   "end": 86.7,
   "text": "У меня есть сестра Перизат, мы росли в Шымкент."
  },
  {
   "id": 13,
   "start": 87.1,
   "end": 93.5,
   "text": "А у Роза своих детей было много, но я их почти не знаю."
  }
 ],
