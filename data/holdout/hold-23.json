{
 "id": "hold-23",
 "narrator": "Данияр",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Данияр, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.4,
   "text": "Моего прадеда звали Оспан, он родился в 1902 году под Түркістан."
  },
  {
   "id": 2,
   "start": 15.8,
   "end": 21.0,
   "text": "Его жену, мою прабабушку, звали Жанар."
  },
  {
   "id": 3,
   "start": 21.4,
   "end": 26.5,
   "text": "У них было двое детей: Арман и Роза."
  },
  {
   "id": 4,
   "start": 26.9,
   "end": 33.7,
   "text": "Арман – это мой дед, атам, он работал бухгалтером в совхозе."
  },
  {
   "id": 5,
   "start": 34.1,
   "end": 42.0,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 42.4,
   "end": 46.5,
   "text": "В 1952 году он женился."
  },
  {
   "id": 7,
   "start": 46.9,
   "end": 52.0,
   "text": "Жену деда звали Сәуле, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.4,
   "end": 61.3,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.7,
   "end": 67.3,
   "text": "У деда и Сәуле родился сын Берік, мой отец."
  },
  {
   "id": 10,
   "start": 67.7,
   "end": 72.0,
   "text": "Отец родился в 1954 году."
  },
  {
   "id": 11,
   "start": 72.4,
   "end": 79.5,
   "text": "Мою маму зовут Қарлыға, она вышла замуж за Берік после института."
  },
  {
   "id": 12,
   "start": 79.9,
   "end": 85.8,
   "text": "У меня есть сестра Гүлнар, мы росли в Баянауыл."
  },
  {
   "id": 13,
   "start": 86.2,
   "end": 92.6,
   "text": "А у Роза своих детей было много, но я их почти не знаю."
  }
 ],
