{
 "id": "hold-00",
 "narrator": "Балжан",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Балжан, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.1,
   "text": "Моего прадеда звали Серік, он родился в 1899 году под Семей."
  },
  {
   "id": 2,
   "start": 15.5,
   "end": 20.7,
   "text": "Его жену, мою прабабушку, звали Жанар."
  },
  {
   "id": 3,
   "start": 21.1,
   "end": 26.2,
   "text": "У них было двое детей: Оспан и Темір."
  },
  {
   "id": 4,
   "start": 26.6,
   "end": 32.4,
   "text": "Оспан – это мой дед, атам, он работал шофёром."
  },
  {
   "id": 5,
   "start": 32.8,
   "end": 40.7,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.1,
   "end": 45.2,
   "text": "В 1954 году он женился."
  },
  {
   "id": 7,
   "start": 45.6,
   "end": 50.8,
   "text": "Жену деда звали Қарлыға, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.2,
   "end": 60.1,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.5,
   "end": 66.4,
   "text": "У деда и Қарлыға родился сын Төлеген, мой отец."
  },
  {
   "id": 10,
   "start": 66.8,
   "end": 71.1,
   "text": "Отец родился в 1950 году."
  },
  {
   "id": 11,
   "start": 71.5,
   "end": 78.8,
   "text": "Мою маму зовут Перизат, она вышла замуж за Төлеген после института."
  },
  {
   "id": 12,
   "start": 79.2,
   "end": 85.1,
   "text": "У меня есть брат Бауыржан, мы росли в Қарқаралы."
  },
  {
   "id": 13,
   "start": 85.5,
   "end": 92.0,
   "text": "А у Темір своих детей было много, но я их почти не знаю."
  },
  {
   "id": 14,
   "start": 92.4,
   "end": 99.6,
   "text": "Жанар дожила до девяноста лет, всё помнила, шежіреге жазып отырды."
  }
 ],
