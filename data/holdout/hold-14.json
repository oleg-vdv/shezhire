{
 "id": "hold-14",
 "narrator": "Ақмарал",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Ақмарал, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.4,
   "text": "Моего прадеда звали Нұрлан, он родился в 1897 году под Қарқаралы."
  },
  {
   "id": 2,
   "start": 15.8,
   "end": 21.0,
   "text": "Его жену, мою прабабушку, звали Сәуле."
  },
  {
   "id": 3,
   "start": 21.4,
   "end": 26.8,
   "text": "У них было двое детей: Мұрат и Бауыржан."
  },
  {
   "id": 4,
   "start": 27.2,
   "end": 33.3,
   "text": "Мұрат – это мой дед, атам, он работал трактористом."
  },
  {
   "id": 5,
   "start": 33.7,
   "end": 41.6,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 42.0,
   "end": 46.1,
   "text": "В 1948 году он женился."
  },
  {
   "id": 7,
   "start": 46.5,
   "end": 51.6,
   "text": "Жену деда звали Гүлнар, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.0,
   "end": 60.9,
   "text": "Дед всю жизнь дружил с соседом, его звали Олжас, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.3,
   "end": 67.2,
   "text": "У деда и Гүлнар родились сын Қайрат и дочь Роза."
  },
  {
   "id": 10,
   "start": 67.6,
   "end": 73.3,
   "text": "Қайрат – мой отец, әкем, родился в 1953 году."
  },
  {
   "id": 11,
   "start": 73.7,
   "end": 80.9,
   "text": "Мою маму зовут Бибігүл, она вышла замуж за Қайрат после института."
  },
  {
   "id": 12,
   "start": 81.3,
   "end": 86.9,
   "text": "У меня есть сестра Жанар, мы росли в Семей."
  },
  {
   "id": 13,
   "start": 87.3,
   "end": 94.0,
   "text": "А у Бауыржан своих детей было много, но я их почти не знаю."
  }
 ],
