{
 "id": "hold-03",
 "narrator": "Шолпан",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.9,
   "text": "Меня зовут Шолпан, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.3,
   "end": 15.3,
   "text": "Моего прадеда звали Ғалым, он родился в 1898 году под Баянауыл."
  },
  {
   "id": 2,
   "start": 15.7,
   "end": 21.0,
   "text": "Его жену, мою прабабушку, звали Балжан."
  },
  {
   "id": 3,
   "start": 21.4,
   "end": 26.7,
   "text": "У них было двое детей: Берік и Қарлыға."
  },
  {
   "id": 4,
   "start": 27.1,
   "end": 32.9,
   "text": "Берік – это мой дед, атам, он работал шофёром."
  },
  {
   "id": 5,
   "start": 33.3,
   "end": 41.2,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.6,
   "end": 45.7,
   "text": "В 1948 году он женился."
  },
  {
   "id": 7,
   "start": 46.1,
   "end": 51.3,
   "text": "Жену деда звали Меруерт, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.7,
   "end": 60.6,
   "text": "Дед всю жизнь дружил с соседом, его звали Олжас, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.0,
   "end": 66.7,
   "text": "У деда и Меруерт родился сын Арман, мой отец."
  },
  {
   "id": 10,
   "start": 67.1,
   "end": 71.4,
   "text": "Отец родился в 1948 году."
  },
  {
   "id": 11,
   "start": 71.8,
   "end": 78.9,
   "text": "Мою маму зовут Перизат, она вышла замуж за Арман после института."
  },
  {
   "id": 12,
   "start": 79.3,
   "end": 85.2,
   "text": "У меня есть сестра Нұрила, мы росли в Павлодар."
  },
  {
   "id": 13,
   "start": 85.6,
   "end": 92.2,
   "text": "А у Қарлыға своих детей было много, но я их почти не знаю."
  },
  {
   "id": 14,
   "start": 92.6,
   "end": 99.9,
   "text": "Балжан дожила до девяноста лет, всё помнила, шежіреге жазып отырды."
  }
 ],
