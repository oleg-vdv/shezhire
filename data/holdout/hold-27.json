{
 "id": "hold-27",
 "narrator": "Сәуле",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Сәуле, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.5,
   "text": "Моего прадеда звали Әбдірахман, он родился в 1900 году под Шымкент."
  },
  {
   "id": 2,
   "start": 15.9,
   "end": 21.2,
   "text": "Его жену, мою прабабушку, звали Гүлнар."
  },
  {
   "id": 3,
   "start": 21.6,
   "end": 26.8,
   "text": "У них было двое детей: Данияр и Арман."
  },
  {
   "id": 4,
   "start": 27.2,
   "end": 33.3,
   "text": "Данияр – это мой дед, атам, он работал почтальоном."
  },
  {
   "id": 5,
   "start": 33.7,
   "end": 41.6,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 42.0,
   "end": 46.1,
   "text": "В 1948 году он женился."
  },
  {
   "id": 7,
   "start": 46.5,
   "end": 51.6,
   "text": "Жену деда звали Ұлжан, это моя әжем."
  },
  {
   "id": 8,
   "start": 52.0,
   "end": 61.0,
   "text": "Дед всю жизнь дружил с соседом, его звали Виктор, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 61.4,
   "end": 67.4,
   "text": "У деда и Ұлжан родился сын Құдайберген, мой отец."
  },
  {
   "id": 10,
   "start": 67.8,
   "end": 72.1,
   "text": "Отец родился в 1955 году."
  },
  {
   "id": 11,
   "start": 72.5,
   "end": 79.9,
   "text": "Мою маму зовут Жанар, она вышла замуж за Құдайберген после института."
  },
  {
   "id": 12,
   "start": 80.3,
   "end": 86.8,
   "text": "А у Арман своих детей было много, но я их почти не знаю."
  }
 ],
