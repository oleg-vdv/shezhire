{
 "id": "hold-25",
 "narrator": "Айгүл",
 "segments": [
  {
   "id": 0,
   "start": 0.0,
   "end": 7.8,
   "text": "Меня зовут Айгүл, я расскажу про нашу семью, как мне рассказывали старшие."
  },
  {
   "id": 1,
   "start": 8.2,
   "end": 15.1,
   "text": "Моего прадеда звали Асқар, он родился в 1890 году под Зайсан."
  },
  {
   "id": 2,
   "start": 15.5,
   "end": 20.7,
   "text": "Его жену, мою прабабушку, звали Сәуле."
  },
  {
   "id": 3,
   "start": 21.1,
   "end": 26.4,
   "text": "У них было двое детей: Жандос и Динара."
  },
  {
   "id": 4,
   "start": 26.8,
   "end": 32.6,
   "text": "Жандос – это мой дед, атам, он работал врачом."
  },
  {
   "id": 5,
   "start": 33.0,
   "end": 40.9,
   "text": "Говорят, был ещё один сын, но он умер маленьким, имени уже никто не помнит."
  },
  {
   "id": 6,
   "start": 41.3,
   "end": 45.4,
   "text": "В 1939 году он женился."
  },
  {
   "id": 7,
   "start": 45.8,
   "end": 50.9,
   "text": "Жену деда звали Нұрила, это моя әжем."
  },
  {
   "id": 8,
   "start": 51.3,
   "end": 60.2,
   "text": "Дед всю жизнь дружил с соседом, его звали Иван, он нам был как родной, но не родственник."
  },
  {
   "id": 9,
   "start": 60.6,
   "end": 66.2,
   "text": "У деда и Нұрила родился сын Темір, мой отец."
  },
  {
   "id": 10,
   "start": 66.6,
   "end": 70.9,
   "text": "Отец родился в 1946 году."
  },
  {
   "id": 11,
   "start": 71.3,
   "end": 78.3,
   "text": "Мою маму зовут Күләш, она вышла замуж за Темір после института."
  },
  {
   "id": 12,
   "start": 78.7,
   "end": 84.5,
   "text": "У меня есть брат Бауыржан, мы росли в Шымкент."
  },
  {
   "id": 13,
   "start": 84.9,
   "end": 91.5,
   "text": "А у Динара своих детей было много, но я их почти не знаю."
  },
  {
   "id": 14,
   "start": 91.9,
   "end": 99.1,
   "text": "Сәуле дожила до девяноста лет, всё помнила, шежіреге жазып отырды."
  }
 ],
